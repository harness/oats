export type {{typeName}}EventStreamStatus =
  | 'idle'
  | 'connecting'
  | 'open'
  | 'reconnecting'
  | 'closed'
  | 'error';

export interface {{typeName}}EventStreamState {
  data?: {{okResponseName}};
  event?: string;
  error?: {{errorResponseName}} | Error;
  status: {{typeName}}EventStreamStatus;
}

export interface {{typeName}}EventStreamRetryOptions {
  /** Max number of reconnect attempts after an unexpected error. Defaults to `3`. */
  maxAttempts?: number;
  /** Base delay (ms) before the first retry attempt. Doubles after each
   * subsequent attempt (exponential backoff). Defaults to `1000`. */
  delayMs?: number;
}

export interface {{typeName}}EventStreamOptions {
  /** Set to `false` to not (re)connect. Defaults to `true`. */
  enabled?: boolean;
  onMessage?: (data: {{okResponseName}}, event?: string) => void;
  onError?: (error: {{errorResponseName}} | Error) => void;
  /**
   * Automatically reconnect (with exponential backoff) after an unexpected
   * stream error, e.g. a dropped connection or a non-2xx response. This does
   * NOT apply when the server closes the stream normally (`onClose`), only
   * on `onError`.
   *
   * Pass `true` to reconnect with the defaults in `{{typeName}}EventStreamRetryOptions`,
   * or pass options to customize. Defaults to disabled (no automatic retry).
   */
  retry?: boolean | {{typeName}}EventStreamRetryOptions;
  /**
   * When set, every message received on this stream is also written into
   * the `@tanstack/react-query` cache under this key, via
   * `queryClient.setQueryData(syncQueryKey, ...)`.
   *
   * Pass the exact query key used by the corresponding `useQuery` hook for
   * this resource (its first argument is the operation id, e.g.
   * `["getVibeOnboarding", props.spaceId, props.appId, props.onboardingId]`)
   * to keep that hook's cached data live-updated from this stream, instead
   * of (or in addition to) reading `data` off of this hook.
   */
  syncQueryKey?: QueryKey;
  /**
   * Transforms a message's data into the value stored at `syncQueryKey`.
   * Defaults to wrapping it the same way `useQuery` hooks generated by this
   * plugin store their data: `{ body: data, headers: new Headers() }`.
   */
  syncQueryData?: (data: {{okResponseName}}) => unknown;
}

const DEFAULT_{{typeName | upcase}}_EVENT_STREAM_RETRY_MAX_ATTEMPTS = 3;
const DEFAULT_{{typeName | upcase}}_EVENT_STREAM_RETRY_DELAY_MS = 1000;

{{description}}
export function {{hookName}}(
  props: {{fetcherPropsName}},
  options?: {{typeName}}EventStreamOptions
): {{typeName}}EventStreamState & { close: () => void } {
  const [state, setState] = useState<{{typeName}}EventStreamState>({ status: 'idle' });
  const closeRef = useRef<() => void>(() => undefined);
  const queryClient = useQueryClient();

  // Kept in sync on every render (without forcing the effect below to
  // re-run), so that connection-handling callbacks always see the latest
  // `onMessage`/`onError`/`syncQueryKey`/etc, even if the caller passes new
  // inline functions on every render.
  const optionsRef = useRef(options);
  optionsRef.current = options;

  useEffect(() => {
    if (optionsRef.current?.enabled === false) {
      closeRef.current();
      setState({ status: 'idle' });
      return;
    }

    let isCleanedUp = false;
    let attempt = 0;
    let retryTimeoutId: ReturnType<typeof setTimeout> | undefined;

    const connect = () => {
      setState((prev) => ({ ...prev, status: attempt === 0 ? 'connecting' : 'reconnecting' }));

      const close = {{fetcherName}}(props, {
        onOpen: () => {
          attempt = 0;
          setState((prev) => ({ ...prev, status: 'open' }));
        },
        onMessage: (message) => {
          setState({ status: 'open', data: message.data, event: message.event });
          optionsRef.current?.onMessage?.(message.data, message.event);

          const syncQueryKey = optionsRef.current?.syncQueryKey;
          if (syncQueryKey) {
            const syncQueryData = optionsRef.current?.syncQueryData;
            queryClient.setQueryData(
              syncQueryKey,
              syncQueryData
                ? syncQueryData(message.data)
                : { body: message.data, headers: new Headers() }
            );
          }
        },
        onError: (error) => {
          setState((prev) => ({ ...prev, status: 'error', error }));
          optionsRef.current?.onError?.(error);

          const retry = optionsRef.current?.retry;
          if (!isCleanedUp && retry) {
            const retryOptions: {{typeName}}EventStreamRetryOptions = retry === true ? {} : retry;
            const maxAttempts =
              retryOptions.maxAttempts ?? DEFAULT_{{typeName | upcase}}_EVENT_STREAM_RETRY_MAX_ATTEMPTS;
            const delayMs =
              retryOptions.delayMs ?? DEFAULT_{{typeName | upcase}}_EVENT_STREAM_RETRY_DELAY_MS;

            if (attempt < maxAttempts) {
              attempt += 1;
              retryTimeoutId = setTimeout(connect, delayMs * 2 ** (attempt - 1));
            }
          }
        },
        onClose: () => setState((prev) => ({ ...prev, status: 'closed' })),
      });

      closeRef.current = close;
    };

    connect();

    return () => {
      isCleanedUp = true;
      if (retryTimeoutId !== undefined) {
        clearTimeout(retryTimeoutId);
      }
      closeRef.current();
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [
    {% for name in pathParamsNamesList -%}
    props{{name | property_accessor}},
    {% endfor -%}
    {% if queryParamsCode -%}
    {% for name in queryParamsNamesList -%}
    props.queryParams{{name | optional_property_accessor}},
    {% endfor -%}
    {%- endif %}
    {% if headerParamsCode -%}
    {% for name in headerParamsNamesList -%}
    props.headers{{name | optional_property_accessor}},
    {% endfor -%}
    {%- endif %}
    options?.enabled,
  ]);

  return { ...state, close: () => closeRef.current() };
}
